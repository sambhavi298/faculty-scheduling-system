# Copy this file to .env and fill in real local values.
# .env itself must NEVER be committed — see .gitignore.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=faculty_scheduling

# HTTP server port (src/server.ts). Optional — defaults to 3000 if unset.
PORT=3000

# Only used by tests/failure-injection/ (npm run test:failure-injection),
# which genuinely stops/restarts your real PostgreSQL server as part of one
# test. On Windows, the service name is auto-detected via
# `Get-Service -Name postgresql*` — you normally don't need to set anything
# here. Set this only if auto-detection fails (PowerShell unavailable, or
# more than one "postgresql*" service installed) or you want to pin it
# explicitly. Find your exact name with `Get-Service -Name postgresql*` in
# PowerShell — commonly `postgresql-x64-<version>`, e.g. postgresql-x64-18.
# PG_WINDOWS_SERVICE_NAME=postgresql-x64-18

# Full command overrides, for anything the two options above don't cover
# (non-Windows setups that don't use `service postgresql start/stop`, etc).
# When set, these win over everything, including PG_WINDOWS_SERVICE_NAME.
# PG_STOP_CMD=net stop postgresql-x64-18
# PG_START_CMD=net start postgresql-x64-18
